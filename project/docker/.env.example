# ---------------------------------------------------------------------------
# LifeLink LOCAL DEVELOPMENT environment example
# ---------------------------------------------------------------------------
# WARNING: DEVELOPMENT ONLY. These are deliberately weak, well-known defaults
# for a throwaway local stack. DO NOT use these values in staging or production,
# and DO NOT reuse a real password here. See
# ../docs/deployment/DEPLOYMENT_GUIDE.md for the production hardening checklist.
#
# Usage:
#   cp .env.example .env      # then edit .env if you need different ports
#   docker compose up -d --build
# ---------------------------------------------------------------------------

# PostgreSQL (service name: db)
POSTGRES_DB=lifelink
POSTGRES_USER=lifelink
POSTGRES_PASSWORD=lifelink_dev_only

# Required HS256 signing key. Use at least 32 random bytes; generate one with:
#   openssl rand -base64 48
# Never reuse a real production key here. The compose stack refuses to start
# without this value so the development fallback can never be deployed silently.
JWT_SECRET=replace-with-a-random-development-only-value

# Host ports. All three services are published on 127.0.0.1 ONLY.
# Remove the corresponding `ports` block in docker-compose.yml to disable it.
POSTGRES_PORT=15432
BACKEND_PORT=18080
FRONTEND_PORT=15173

# Seed the documented demo users/organizations on an empty database.
# Set to false when importing your own data.
SEED_DEMO_DATA=true

# In-memory auth endpoint limiter. The default intentionally blocks brute force;
# raise only for scripted local E2E runs against this single backend instance.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# JVM tuning passed to the backend container.
JAVA_OPTS=-Xms128m -Xmx512m -XX:MaxRAMPercentage=65.0

# Base path the built SPA uses for API calls. The nginx runtime proxies
# /api/* to http://backend:8080/api/* inside the Compose network.
VITE_API_BASE_URL=/api

# Browser origins accepted by Spring Security and the SockJS handshake. The
# Compose default already includes localhost and 127.0.0.1 on FRONTEND_PORT;
# override this only when serving the SPA from a different host or port.
# CORS_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# Playwright starts its own Vite server and proxies /api here. Keep this equal to
# BACKEND_PORT; 18080 is the verified default because 8080 is often occupied.
# VITE_API_PROXY_TARGET=http://127.0.0.1:18080

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Practical4 Run",
      "type": "shell",
      "command": "cmd /c javac -encoding UTF-8 -d out src\\Practical4Demo.java && java -cp out Practical4Demo && echo DONE",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
